{
  "name": "supplyguard-backend",
  "version": "1.0.0",
  "description": "SupplyGuard AI Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/backend/src/index.js",
    "dev": "ts-node src/index.ts",
    "dev:ts": "npx ts-node -r tsconfig-paths/register src/index.ts",
    "dev:watch": "nodemon --exec 'npx ts-node' src/index.ts",
    "db:seed": "ts-node src/scripts/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "mongoose": "^9.10.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
